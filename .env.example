# ── Base de datos ─────────────────────────────────────────────
# La base corre en Docker (compose.yaml): usuario, contraseña y nombre
# son "kilora". Cambiar aquí y en compose.yaml si se modifican.
DATABASE_URL=postgres://kilora:kilora@localhost:5432/kilora?sslmode=disable

# ── API ───────────────────────────────────────────────────────
API_ADDR=:8080
# Origen permitido para CORS y cookies
WEB_ORIGIN=http://localhost:3300

# ── Sesiones ──────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
# development | production (production exige SESSION_SECRET y cookies seguras).
APP_ENV=development
SESSION_SECRET=

# ── Correo transaccional (verificación, invitaciones) ─────────
RESEND_API_KEY=
EMAIL_FROM=no-reply@kilora.com

# ── Storage de fotos (R2 / Supabase) ──────────────────────────
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Asistente de IA (OpenAI) ──────────────────────────────────
# Sin clave el asistente queda desactivado (responde 503).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# low | medium | high. Dejar vacío si el modelo no razona (p. ej. gpt-4.1-mini).
OPENAI_REASONING_EFFORT=low

# ── Frontend ──────────────────────────────────────────────────
# Vacío = mismo origen; Vite redirige /api al API en desarrollo.
VITE_API_URL=
# URL pública canónica (SEO: canonical, Open Graph, JSON-LD).
VITE_SITE_URL=https://kilora.app

# Habilita acceso público a las cuentas de demostración.
DEMO_MODE=true
