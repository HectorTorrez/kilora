# Copy to .env.production in the repository root and chmod 600.
DOMAIN=your-domain.example
# Public demo deployments only; creates fictional data on API startup.
DEMO_MODE=false
# Use only hex characters for this password (openssl rand -hex 32).
POSTGRES_PASSWORD=
# openssl rand -base64 48
SESSION_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Kilora <no-reply@your-domain.example>
OPENAI_API_KEY=
# Set to the release commit SHA; retain previous images for rollback.
RELEASE_TAG=local
