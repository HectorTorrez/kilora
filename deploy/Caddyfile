{$DOMAIN} {
 encode zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy strict-origin-when-cross-origin
  Strict-Transport-Security "max-age=31536000"
 }
 @api path /api /api/* /healthz
 handle @api {
  reverse_proxy api:8080 {
   flush_interval -1
  }
 }
 handle {
  reverse_proxy web:3000
 }
}
